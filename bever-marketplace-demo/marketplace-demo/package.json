{
  "name": "bever-marketplace-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small B2B marketplace demo used as a shared test fixture for AI coding tools. All suppliers, prices and stock are fictional.",
  "scripts": {
    "dev": "concurrently -n api,web -c green,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
